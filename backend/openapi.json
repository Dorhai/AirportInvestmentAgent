            "type": "string",
            "enum": [
              "NOT_PUBLISHED",
              "PROVIDER_FAILED",
              "NO_DEPARTURES",
              "OUT_OF_SCOPE"
            ],
            "title": "Reason"
          },
          "detail": {
            "type": "string",
            "title": "Detail"
          },
          "attempted": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Attempted"
          }
        },
        "type": "object",
        "required": [
          "reason",
          "detail",
          "attempted"
        ],
        "title": "Absent"
      },
      "AirportContext": {
        "properties": {
          "nas_delay_program": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DelayProgram"
              },
              {
                "type": "null"
              }
            ]
          },
          "weather": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/WeatherContext"
              },
              {
                "type": "null"
              }
